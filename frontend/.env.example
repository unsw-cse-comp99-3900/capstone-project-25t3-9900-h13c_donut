# SystemX Frontend Environment Configuration Template
# 前端环境配置模板文件（复制为 .env 并修改）

# API Base URL (后端 API 地址)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket Base URL (WebSocket 服务地址)
VITE_WS_BASE_URL=ws://localhost:8000

# 是否使用本地语音识别（0=使用后端，1=使用浏览器本地）
VITE_USE_LOCAL_SPEECH=0

# 生产环境示例：
# VITE_API_BASE_URL=https://api.systemx.example.com
# VITE_WS_BASE_URL=wss://api.systemx.example.com